# 開發 / 上線環境設定範例。複製為 .env 後填入實際值（.env 不可入版控）。
# scripts/serve.sh 會自動載入本檔；也可用 `set -a; source .env; set +a` 手動載入。

# ---- 監聽位址 ----
# 127.0.0.1 只有本機能連；要讓同網段的朋友直接連，改成 0.0.0.0
AC_HOST=127.0.0.1
AC_PORT=8000
# SQLite 寫入是單檔鎖，worker 保持 1
AC_WORKERS=1

# ---- 資料庫 ----
# 開發用 SQLite（留空即使用 backend/data/community.db）
# 上線改指向 PostgreSQL，例如：
# AC_DATABASE_URL=postgresql+psycopg://ac_user:密碼@127.0.0.1:5432/agent_community

# ---- 上線安全開關 ----
# 走 HTTPS（Cloudflare 通道 / nginx + 憑證）後務必設為 1，讓 Cookie 只在加密連線傳輸
AC_COOKIE_SECURE=0
# 置於反向代理後方時設為 1，限流才會看到真實來源 IP
AC_TRUST_PROXY=0
# 登入態保存天數
AC_SESSION_TTL_DAYS=30

# ---- 限流（同一來源 IP 的滑動視窗）----
AC_LOGIN_RATE_LIMIT=10
AC_LOGIN_RATE_WINDOW=60
AC_REGISTER_RATE_LIMIT=5
AC_REGISTER_RATE_WINDOW=3600

# ---- 跨來源（前後端同源部署時可留空）----
AC_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
